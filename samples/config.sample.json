{
  "review": {
    "protectedPaths": [
      "YOUR_AUTHORITY_PATH/**"
    ],
    "trustedCheckActors": [
      "YOUR_CHECK_APP"
    ],
    "trustedTriageActors": [
      "triage-app"
    ],
    "requiredChecks": [
      "YOUR_REQUIRED_CHECK"
    ],
    "cardBundle": {
      "commit": "0000000000000000000000000000000000000000"
    },
    "classificationThreshold": 0.6,
    "routeThreshold": 0.35,
    "riskTailThreshold": 0.3,
    "confidenceThreshold": 0.3,
    "noCouncilConfidenceFloor": 0.3,
    "timeoutMs": 900000,
    "publication": "record",
    "calibration": false,
    "trustedLedgerActors": [
      "YOUR_REVIEW_APP[bot]"
    ]
  },
  "github": {
    "freshShadow": false
  },
  "jev": {
    "model": "YOUR_JEV_VERSION"
  },
  "claude": {
    "executable": "/path/to/your/claude",
    "ticketing": {
      "server": "YOUR_TICKETING_MCP_SERVER_NAME",
      "command": "/path/to/your/ticketing-mcp-server",
      "args": ["YOUR_SERVER_ARGUMENT"],
      "env": ["YOUR_TICKETING_CREDENTIAL_ENV_VAR"],
      "tools": ["mcp__YOUR_TICKETING_MCP_SERVER_NAME__YOUR_READ_TOOL"]
    },
    "version": "0.0.0",
    "pluginDirectory": "/path/to/your/publish-skills",
    "reviewerModel": "YOUR_REVIEWER_MODEL"
  }
}
