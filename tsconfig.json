{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "isolatedModules": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "tests"]
}
