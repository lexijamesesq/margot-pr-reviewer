{
  "name": "margot-pr-reviewer",
  "version": "0.6.4",
  "description": "Margot, the PR reviewer: review, convergence and GitHub publication",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recordings/*": "./recordings/*"
  },
  "files": [
    "dist",
    "recordings",
    "README.md",
    "LICENSE",
    "samples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "audit:recordings": "node scripts/audit-recordings.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "octokit": "5.0.5",
    "p-retry": "8.0.1",
    "parse-diff": "0.12.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "@types/picomatch": "4.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "bin": {
    "margot-review": "dist/cli.js",
    "margot-instance": "dist/instance-cli.js"
  }
}
